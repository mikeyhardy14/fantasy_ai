# ---- Database ---------------------------------------------------------------
# Postgres (docker-compose default). For local dev without Docker you may use
# SQLite: sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://fantasy:fantasy@localhost:5432/fantasy_ai
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=fantasy
POSTGRES_DB=fantasy_ai

# ---- Auth -------------------------------------------------------------------
# Use a long random string (>= 32 chars). e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# Fernet key for the Sleeper account token (and future OAuth tokens).
# In development an empty value generates backend/.credentials_key automatically.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# ---- AI ---------------------------------------------------------------------
# Free assistant. A Gemini key from https://aistudio.google.com/apikey lets the
# assistant change this week's Sleeper lineup. Leave every key empty for rule-based mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Used only when GEMINI_API_KEY is empty. Free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Used only when both free keys are empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOOL_ROUNDS=8

# ---- App --------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
DEMO_ENABLED=true
DEFAULT_SEASON=2026

# Sleeper (public API, no credentials)
SLEEPER_BASE_URL=https://api.sleeper.app/v1
SLEEPER_PLAYER_CACHE_TTL_HOURS=24

# ---- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
